{
  "expo": {
    "name": "FinControl",
    "slug": "FinControl",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "FinControl",
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.henriquebrmsteam.FinControl"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O FinControl usa o Face ID para proteger o acesso a sua conta."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "686d87d6-71ee-4e07-9365-6ed8c25a61d5"
      }
    }
  }
}
